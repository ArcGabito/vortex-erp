@page "/"
@inherits ErpPage

<SectionContent SectionName="page-title">@T("home.panel")</SectionContent>

@if (_summary is { } s)
{
    <div class="stat-strip">
        <StatTile Icon="wallet" Label="@(T("home.ingresos_del_mes"))" Value="@Fmt.MoneyCompact(s.RevenueMonth, s.CurrencyCode)" Delta="s.RevenueChangePct" Hint="@(s.RevenueChangePct is null ? null : T("home.vs_mes_pasado_la_fecha"))" />
        <StatTile Icon="receipt" Label="@(T("home.por_cobrar"))" Value="@Fmt.MoneyCompact(s.Receivable, s.CurrencyCode)" Hint="@(s.Overdue > 0 ? T("home.vencido", (Fmt.MoneyCompact(s.Overdue, s.CurrencyCode))) : "nada vencido")" />
        <StatTile Icon="clipboard" Label="@(T("home.por_facturar"))" Value="@Fmt.Compact(s.OrdersOpen + s.PosSalesToInvoice)" Hint="@(T("home.pedidos_de_caja", s.OrdersOpen, s.PosSalesToInvoice))" />
        <StatTile Icon="truck" Label="@(T("home.compras_por_recibir"))" Value="@Fmt.Compact(s.PurchasesOpen)" />
        <StatTile Icon="boxes" Label="@(T("home.inventario"))" Value="@Fmt.MoneyCompact(s.InventoryValue, s.CurrencyCode)" Hint="@(T("home.valorizado"))" />
    </div>
}

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("home.hola", FirstName)</h2>
            <p>@T("home.asi_van_las_cuentas_de", (Session.Session?.Access.OrganizationName))</p>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap">
            <a class="btn btn-outline" href="compras"><Icon Name="truck" Size="18" />@T("home.comprar")</a>
            <a class="btn btn-dark" href="pedidos"><Icon Name="plus" Size="18" />@T("home.nuevo_pedido")</a>
        </div>
    </div>

    <div class="grid-2">
        <div class="card">
            <div class="card-head">
                <div>
                    <h3>@T("home.ingresos_de_los_ultimos_6")</h3>
                    <div class="sub">@T("home.comprobantes_de_pedidos_ventas_de")</div>
                </div>
            </div>
            <div class="card-body">
                @if (_months.All(m => m.Invoiced + m.PosSales == 0))
                {
                    <EmptyState Icon="wallet" Title="@(T("home.aun_no_hay_ingresos"))" Text="@(T("home.factura_un_pedido_vende_en"))" />
                }
                else
                {
                    var max = _months.Max(m => m.Invoiced + m.PosSales);
                    <div class="chart-bars" role="img" aria-label="@(T("home.ingresos_por_mes"))">
                        @foreach (var m in _months)
                        {
                            var total = m.Invoiced + m.PosSales;
                            <div class="col" title="@(T("home.facturado_en_caja", (Fmt.Money(m.Invoiced, Currency)), (Fmt.Money(m.PosSales, Currency))))">
                                <span class="value">@Fmt.Compact(total)</span>
                                <div class="stack" style="height:@((int)(total / max * 100))%">
                                    <span class="pos" style="flex:@((double)m.PosSales)"></span>
                                    <span class="inv" style="flex:@((double)m.Invoiced)"></span>
                                </div>
                                <span class="label">@m.Month.ToString("MMM", Fmt.Culture)</span>
                            </div>
                        }
                    </div>
                    <div class="legend"><span class="inv"></span>@T("home.pedidos_facturados") <span class="pos"></span>@T("home.ventas_de_caja")</div>
                }
            </div>
        </div>

        <div style="display:flex;flex-direction:column;gap:20px;min-width:0">
            <div class="card">
                <div class="card-head">
                    <div>
                        <h3>@T("home.requiere_atencion")</h3>
                        <div class="sub">@T("home.lo_que_espera_una_accion")</div>
                    </div>
                </div>
                <div class="card-body">
                    @if (_summary is { } a)
                    {
                        <a class="list-row" href="pedidos">
                            <Icon Name="star" Size="18" Class="faint" /><span>@T("home.cotizaciones_del_crm_por_convertir")</span><strong class="end">@a.QuotesToConvert</strong>
                        </a>
                        <a class="list-row" href="pedidos">
                            <Icon Name="clipboard" Size="18" Class="faint" /><span>@T("home.pedidos_por_facturar")</span><strong class="end">@a.OrdersOpen</strong>
                        </a>
                        <a class="list-row" href="comprobantes?caja=1">
                            <Icon Name="receipt" Size="18" Class="faint" /><span>@T("home.ventas_de_caja_sin_comprobante")</span><strong class="end">@a.PosSalesToInvoice</strong>
                        </a>
                        <a class="list-row" href="cobranzas">
                            <Icon Name="alert" Size="18" Class="faint" /><span>@T("home.comprobantes_vencidos")</span><strong class="end @(a.OverdueInvoices > 0 ? "qty-neg" : "")">@a.OverdueInvoices</strong>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private DashboardSummary? _summary;
    private IReadOnlyList<MonthRevenue> _months = [];

    private string Currency => _summary?.CurrencyCode ?? "PEN";
    private string FirstName => Session.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

    protected override async Task LoadAsync()
    {
        _summary = await Erp.Reports.GetDashboardAsync();
        _months = await Erp.Reports.GetMonthlyRevenueAsync();
    }
}

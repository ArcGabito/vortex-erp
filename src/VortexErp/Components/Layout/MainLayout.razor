@inherits LayoutComponentBase
@implements IDisposable
@inject AppSession Session
@inject NavigationManager Nav

@if (Session.IsSignedIn)
{
    <div class="app">
        <div class="sidebar-backdrop @(_menuOpen ? "open" : "")" @onclick="() => _menuOpen = false"></div>
        <aside class="sidebar @(_menuOpen ? "open" : "")">
            <a class="workspace" href="configuracion" @onclick="() => _menuOpen = false">
                <span class="workspace-mark"><Logo IconOnly Size="26" /></span>
                <span class="two-line">
                    <span class="t2">Vortex ERP</span>
                    <span class="t1">@Session.Session?.Access.OrganizationName</span>
                </span>
                <Icon Name="chevron-down" Size="16" Class="faint" />
            </a>

            <nav class="nav" @onclick="() => _menuOpen = false">
                <div class="nav-section">@T("nav.principal")</div>
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All"><Icon Name="home" />@T("nav.panel")</NavLink>

                <div class="nav-section">@T("nav.ventas")</div>
                <NavLink class="nav-link" href="pedidos">
                    <Icon Name="clipboard" />@T("nav.pedidos")
                    @if (_toInvoice > 0)
                    {
                        <span class="count" title="@(T("nav.pedidos_cotizaciones_por_atender"))">@_toInvoice</span>
                    }
                </NavLink>
                <NavLink class="nav-link" href="comprobantes"><Icon Name="receipt" />@T("nav.comprobantes")</NavLink>
                <NavLink class="nav-link" href="cobranzas">
                    <Icon Name="wallet" />@T("nav.cobranzas")
                    @if (_overdue > 0)
                    {
                        <span class="count" title="@(T("nav.comprobantes_vencidos"))">@_overdue</span>
                    }
                </NavLink>

                <div class="nav-section">@T("nav.operaciones")</div>
                <NavLink class="nav-link" href="compras"><Icon Name="truck" />@T("nav.compras")</NavLink>
                <NavLink class="nav-link" href="inventario"><Icon Name="boxes" />@T("nav.inventario")</NavLink>

                <div class="nav-section">@T("nav.catalogo")</div>
                <NavLink class="nav-link" href="articulos"><Icon Name="tag" />@T("nav.articulos")</NavLink>
                <NavLink class="nav-link" href="socios"><Icon Name="users" />@T("nav.clientes_proveedores")</NavLink>
                <NavLink class="nav-link" href="sedes"><Icon Name="warehouse" />@T("nav.sedes")</NavLink>

                <div class="nav-section">@T("nav.sistema")</div>
                @if (Session.Can(ErpPermissions.ViewAudit))
                {
                    <NavLink class="nav-link" href="auditoria"><Icon Name="list" />@T("nav.auditoria")</NavLink>
                }
                <NavLink class="nav-link" href="configuracion"><Icon Name="settings" />@T("nav.configuracion")</NavLink>
            </nav>

            <div class="menu-anchor user-anchor">
                <button class="user-card" @onclick="() => _userMenu = !_userMenu" aria-label="@(T("topbar.cuenta"))">
                    <span class="avatar-wrap"><Avatar Text="@Session.UserName" Size="36" Class="user" /><span class="presence @(Session.Connection == ConnectionState.Online ? "on" : "")"></span></span>
                    <span class="two-line">
                        <span class="t1">@Session.UserName</span>
                        <span class="t2">@(Session.Session?.Access.Role ?? Session.Session?.Access.OrganizationName)</span>
                    </span>
                    <Icon Name="chevron-down" Size="16" Class="faint" />
                </button>
                @if (_userMenu)
                {
                    <div class="menu-backdrop" @onclick="() => _userMenu = false"></div>
                    <div class="menu up" @onclick="() => { _userMenu = false; _menuOpen = false; }">
                        <div style="padding:10px 12px 8px">
                            <div style="font-weight:600">@Session.UserName</div>
                            <div class="muted" style="font-size:12px">@Session.Session?.User.Email</div>
                        </div>
                        <hr />
                        <a href="configuracion"><Icon Name="settings" Size="18" />@T("topbar.configuracion")</a>
                        <button @onclick="OpenRepoAsync"><Icon Name="external" Size="18" />@T("nav.contribuir")</button>
                        <button class="danger" @onclick="Session.SignOutAsync"><Icon Name="logout" Size="18" />@T("topbar.cerrar_sesion")</button>
                    </div>
                }
            </div>
        </aside>

        <div class="main">
            <TopBar OnMenu="() => _menuOpen = !_menuOpen" />
            <div class="content">
                <ErrorBoundary @ref="_boundary">
                    @Body
                </ErrorBoundary>
            </div>
        </div>
    </div>
}

@code {
    private bool _menuOpen, _userMenu;
    private int _toInvoice, _overdue;
    private ErrorBoundary? _boundary;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Session.DataChanged += OnDataChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!Session.IsSignedIn)
        {
            Nav.NavigateTo("login", replace: true);
            return;
        }
        await LoadCountsAsync();
    }

    private async Task LoadCountsAsync()
    {
        if (Session.Workspace is not { } erp)
            return;
        var summary = await erp.Reports.GetDashboardAsync();
        _toInvoice = summary.OrdersOpen + summary.QuotesToConvert;
        _overdue = summary.OverdueInvoices;
    }

    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        if (!Session.IsSignedIn)
            Nav.NavigateTo("login", replace: true);
        StateHasChanged();
    });

    private void OnDataChanged() => _ = InvokeAsync(async () =>
    {
        await LoadCountsAsync();
        StateHasChanged();
    });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _boundary?.Recover();

    private static Task OpenRepoAsync() => Launcher.Default.OpenAsync("https://github.com/ArcGabito/vortex-erp");

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Session.DataChanged -= OnDataChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}

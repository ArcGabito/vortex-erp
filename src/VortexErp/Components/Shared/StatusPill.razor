@* Estado con punto + texto (el color nunca va solo). Tonos: good, info, warn, bad, neutral, accent. *@
<span class="pill @Tone @(Plain ? "plain" : "")">@Text</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";
    [Parameter] public string Tone { get; set; } = "neutral";
    [Parameter] public bool Plain { get; set; }

    public static (string Text, string Tone) ForOrder(OrderRow o) =>
        o.Status == OrderStatuses.Cancelled ? (T("statuspill.cancelado"), "neutral")
        : o.InvoiceId is not null ? (T("statuspill.facturado"), "good")
        : o.Status == OrderStatuses.Dispatched ? (T("statuspill.despachado"), "info")
        : (T("statuspill.abierto"), "warn");

    public static (string Text, string Tone) ForInvoice(InvoiceRow i, DateOnly today) =>
        i.IsPaid ? (T("statuspill.pagado"), "good")
        : i.IsOverdue(today) ? (T("statuspill.vencido"), "bad")
        : i.Paid > 0 ? (T("statuspill.pago_parcial"), "warn")
        : (T("statuspill.por_cobrar"), "info");

    public static (string Text, string Tone) ForPurchase(string status) => status switch
    {
        PurchaseStatuses.Open => (T("statuspill.por_recibir"), "info"),
        PurchaseStatuses.Partial => (T("statuspill.recibida_en_parte"), "warn"),
        PurchaseStatuses.Received => (T("statuspill.recibida"), "good"),
        _ => (T("statuspill.cancelada"), "neutral"),
    };
}

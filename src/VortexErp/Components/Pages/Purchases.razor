@page "/compras"
@inherits ErpPage

<SectionContent SectionName="page-title">@T("purchases.compras")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("purchases.ordenes_de_compra")</h2>
            <p>@T("purchases.al_crearlas_el_wms_prepara")</p>
        </div>
        @if (Session.Can(ErpPermissions.CreatePurchase))
        {
            <button class="btn btn-dark" @onclick="OpenNew"><Icon Name="plus" Size="18" />@T("purchases.nueva_orden")</button>
        }
    </div>

    <div class="filters">
        <div class="field search">
            <label>@T("purchases.buscar")</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="@(T("purchases.numero_proveedor"))" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="field" style="width:auto">
            <label>@T("purchases.mostrar")</label>
            <div class="segmented">
                @foreach (var (value, label) in Tabs)
                {
                    <button class="@(_status == value ? "on" : "")" @onclick="async () => { _status = value; _page = 1; await ReloadAsync(); }">@label</button>
                }
            </div>
        </div>
    </div>

    @if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="truck" Title="@(T("purchases.no_hay_ordenes_de_compra"))" Text="@(T("purchases.crea_una_orden_para_reponer"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>@T("purchases.orden_2")</th><th>@T("purchases.proveedor")</th><th>@T("purchases.recibe")</th><th class="num">@T("purchases.recibido")</th><th class="num">@T("purchases.total")</th><th>@T("purchases.estado")</th><th class="actions-col"></th></tr></thead>
                    <tbody>
                        @foreach (var o in page.Items)
                        {
                            var (text, tone) = StatusPill.ForPurchase(o.Status);
                            <tr @key="o.Id" style="cursor:pointer" @onclick="() => OpenAsync(o)">
                                <td><div class="two-line"><span class="t1">@o.Number</span><span class="t2">@Fmt.Date(o.CreatedAt)@(o.ExpectedAt is { } exp ? T("purchases.llega_el", Fmt.Date(exp)) : "")</span></div></td>
                                <td><span style="font-weight:600">@o.SupplierName</span></td>
                                <td><span class="muted">@o.SiteName</span></td>
                                <td class="num">@Fmt.Qty(o.Received) / @Fmt.Qty(o.Ordered)</td>
                                <td class="num strong">@Fmt.Money(o.Total, o.CurrencyCode)</td>
                                <td><StatusPill Text="@text" Tone="@tone" /></td>
                                <td class="actions-col" @onclick:stopPropagation>
                                    @if ((o.Status is PurchaseStatuses.Open or PurchaseStatuses.Partial && Session.Can(ErpPermissions.CancelPurchase))
                                         || Session.Can(ErpPermissions.PaySuppliers))
                                    {
                                        <KebabMenu>
                                            @if (Session.Can(ErpPermissions.PaySuppliers) && o.Received > 0)
                                            {
                                                <button @onclick='() => Nav.NavigateTo($"por-pagar?orden={o.Id}")'><Icon Name="receipt" Size="18" />@T("purchases.registrar_factura")</button>
                                            }
                                            @if (o.Status is PurchaseStatuses.Open or PurchaseStatuses.Partial && Session.Can(ErpPermissions.CancelPurchase))
                                            {
                                                <button class="danger" @onclick="() => (_cancel, _reason, _error) = (o, null, null)"><Icon Name="ban" Size="18" />@T("purchases.cancelar")</button>
                                            }
                                        </KebabMenu>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="@(T("purchases.ordenes"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_new is { } n)
{
    <Modal Title="@(T("purchases.nueva_orden_de_compra"))" Subtitle="@(T("purchases.el_wms_la_vera_como"))" Size="lg" Error="@_error" OnClose="() => _new = null">
        <ChildContent>
            <div class="form-row three">
                <div class="field">
                    <label>@T("purchases.proveedor")</label>
                    <select class="select" @bind="n.SupplierId">
                        <option value="">@T("purchases.elige_un_proveedor")</option>
                        @foreach (var s in _suppliers)
                        {
                            <option value="@s.Id">@s.Label</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>@T("purchases.almacen_que_recibe")</label>
                    <select class="select" @bind="n.SiteId">
                        <option value="">@T("purchases.sede_por_defecto")</option>
                        @foreach (var s in _sites)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>@T("purchases.llega_el_opcional")</label>
                    <input class="control" type="date" @bind="n.ExpectedAt" />
                </div>
            </div>
            <LineEditor Lines="n.Lines" ShowPrice PriceLabel="@(T("purchases.costo_unitario"))" Changed="StateHasChanged" />
            <dl class="totals">
                <dt class="grand">@T("purchases.total")</dt><dd class="grand">@Fmt.Money(n.Lines.Sum(l => Tax.Round(l.Quantity * (l.Price ?? 0))), _currency)</dd>
            </dl>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _new = null">@T("purchases.cancelar")</button>
            <button class="btn btn-dark" disabled="@(_busy || n.Lines.Count == 0 || n.SupplierId is null)" @onclick="CreateAsync">@T("purchases.crear_orden")</button>
        </Footer>
    </Modal>
}

@if (_detail is { } d)
{
    var (text, tone) = StatusPill.ForPurchase(d.Status);
    <Modal Title="@(T("purchases.orden", d.Number))" Subtitle="@($"{d.SupplierName} · {d.SiteName}")" Size="lg" OnClose="() => _detail = null">
        <ChildContent>
            <div><StatusPill Text="@text" Tone="@tone" /></div>
            <div class="table-wrap">
                <table class="data" style="min-width:480px">
                    <thead><tr><th>@T("purchases.articulo")</th><th class="num">@T("purchases.pedido")</th><th class="num">@T("purchases.recibido")</th><th class="num">@T("purchases.costo")</th><th class="num">@T("purchases.importe")</th></tr></thead>
                    <tbody>
                        @foreach (var l in _lines)
                        {
                            <tr>
                                <td><div class="two-line"><span class="t1">@l.ItemName</span><span class="t2">#@l.Sku</span></div></td>
                                <td class="num">@Fmt.Qty(l.Quantity)</td>
                                <td class="num"><span class="@(l.ReceivedQty >= l.Quantity ? "qty-pos" : "warn-text")">@Fmt.Qty(l.ReceivedQty)</span></td>
                                <td class="num">@Fmt.Money(l.UnitCost, d.CurrencyCode)</td>
                                <td class="num strong">@Fmt.Money(l.Total, d.CurrencyCode)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <dl class="totals"><dt class="grand">@T("purchases.total")</dt><dd class="grand">@Fmt.Money(d.Total, d.CurrencyCode)</dd></dl>
        </ChildContent>
        <Footer>
            <button class="btn btn-dark" @onclick="() => _detail = null">@T("purchases.cerrar")</button>
        </Footer>
    </Modal>
}

@if (_cancel is { } cx)
{
    <Modal Title="@(T("purchases.cancelar_n", cx.Number))" Subtitle="@(cx.Received > 0 ? T("purchases.cancelar_parcial_explica") : T("purchases.cancelar_explica"))"
           Size="sm" Error="@_error" OnClose="() => _cancel = null">
        <ChildContent>
            <div class="field"><label>@T("purchases.motivo")</label><input class="control" @bind="_reason" /></div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _cancel = null">@T("purchases.volver")</button>
            <button class="btn btn-danger" disabled="@_busy" @onclick="CancelAsync">@T("purchases.cancelar_orden")</button>
        </Footer>
    </Modal>
}

@code {
    private PurchaseRow? _cancel;
    private string? _reason;

    private sealed class NewPurchase
    {
        public Guid? SupplierId { get; set; }
        public Guid? SiteId { get; set; }
        public DateOnly? ExpectedAt { get; set; }
        public List<LineEditor.LineDraft> Lines { get; } = [];
    }

    private static readonly (string Value, string Label)[] Tabs =
        [("pending", T("purchases.por_recibir")), (PurchaseStatuses.Received, T("purchases.recibidas")), (PurchaseStatuses.Cancelled, T("purchases.canceladas")), ("", T("purchases.todas"))];

    private PagedResult<PurchaseRow>? _result;
    private IReadOnlyList<Option> _suppliers = [];
    private IReadOnlyList<SiteRow> _sites = [];
    private string _search = "", _status = "pending", _currency = "PEN";
    private int _page = 1;
    private CancellationTokenSource? _debounce;
    private NewPurchase? _new;
    private PurchaseRow? _detail;
    private IReadOnlyList<PurchaseLineRow> _lines = [];
    private string? _error;
    private bool _busy;

    protected override async Task LoadAsync()
    {
        _result = await Erp.Purchases.GetPurchasesAsync(_search, _status == "" ? null : _status, _page, 15);
        _currency = (await Erp.Master.GetCompanyAsync())?.CurrencyCode ?? "PEN";
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OpenNew()
    {
        _error = null;
        _suppliers = await Erp.Master.GetPartyOptionsAsync(suppliers: true);
        _sites = await Erp.Master.GetSitesAsync(activeOnly: true);
        _new = new NewPurchase { SiteId = Session.DefaultSiteId };
    }

    private async Task CreateAsync()
    {
        if (_new is not { SupplierId: { } supplier } n)
            return;
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = await Erp.Purchases.CreateAsync(supplier, n.SiteId,
            n.Lines.Select(l => l.ToDocumentLine()).ToList(), _currency, n.ExpectedAt));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success(T("purchases.orden_creada", number));
            _new = null;
        }
    }

    private async Task OpenAsync(PurchaseRow order)
    {
        _lines = await Erp.Purchases.GetLinesAsync(order.Id);
        _detail = order;
    }

    private async Task CancelAsync()
    {
        if (_cancel is not { } order)
            return;
        _busy = true;
        _error = await TryAsync(() => Erp.Purchases.CancelAsync(order.Id, _reason), T("purchases.orden_cancelada", order.Number));
        _busy = false;
        if (_error is null)
        {
            _cancel = null;
            await ReloadAsync();
        }
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}

@page "/pedidos"
@inherits ErpPage

<SectionContent SectionName="page-title">@T("orders.pedidos_2")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("orders.pedidos_de_venta")</h2>
            <p>@T("orders.los_que_creas_aqui_los")</p>
        </div>
        @if (Session.Can(ErpPermissions.CreateOrder))
        {
            <button class="btn btn-dark" @onclick="OpenNew"><Icon Name="plus" Size="18" />@T("orders.nuevo_pedido")</button>
        }
    </div>

    @if (_quotes.Count > 0)
    {
        <div class="card">
            <div class="card-head">
                <div>
                    <h3>@T("orders.cotizaciones_aceptadas_en_el_crm")</h3>
                    <div class="sub">@T("orders.conviertelas_en_pedido_para_que")</div>
                </div>
            </div>
            <div class="card-body">
                @foreach (var q in _quotes)
                {
                    <div class="list-row" @key="q.Id">
                        <Avatar Text="@(q.CustomerName ?? "?")" Size="36" />
                        <div class="two-line" style="flex:1">
                            <span class="t1">@(q.Number ?? T("orders.cotizacion")) · @(q.CustomerName ?? T("orders.cliente_desconocido"))</span>
                            <span class="t2">@T("orders.aceptada", Fmt.Ago(q.AcceptedAt), (Fmt.Count(q.LineCount, T("count.linea"), T("count.lineas"))))</span>
                        </div>
                        <strong>@Fmt.Money(q.Total, q.CurrencyCode)</strong>
                        <button class="btn btn-sm btn-dark" disabled="@(_busy || q.CustomerId is null || !Session.Can(ErpPermissions.ConvertQuote))" @onclick="() => ConvertAsync(q)">@T("orders.crear_pedido")</button>
                    </div>
                }
            </div>
        </div>
    }

    <div class="filters">
        <div class="field search">
            <label>@T("orders.buscar")</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="@(T("orders.numero_cliente_ruc"))" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="field" style="width:auto">
            <label>@T("orders.mostrar")</label>
            <div class="segmented">
                @foreach (var (value, label) in Tabs)
                {
                    <button class="@(_status == value ? "on" : "")" @onclick="async () => { _status = value; _page = 1; await ReloadAsync(); }">@label</button>
                }
            </div>
        </div>
    </div>

    @if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="clipboard" Title="@(T("orders.no_hay_pedidos"))" Text="@(T("orders.crea_un_pedido_espera_los"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr><th>@T("orders.pedido_2")</th><th>@T("orders.cliente")</th><th>@T("orders.origen")</th><th class="num">@T("orders.total")</th><th>@T("orders.estado")</th><th class="actions-col">@T("orders.acciones")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var o in page.Items)
                        {
                            var (text, tone) = StatusPill.ForOrder(o);
                            <tr @key="o.Id" style="cursor:pointer" @onclick="() => OpenAsync(o)">
                                <td><div class="two-line"><span class="t1">@o.Number</span><span class="t2">@Fmt.DateTime(o.CreatedAt) · @(o.SiteName ?? T("orders.sin_sede"))</span></div></td>
                                <td><span style="font-weight:600">@(o.CustomerName ?? "—")</span></td>
                                <td><span class="muted">@Fmt.Source(o.Source)</span></td>
                                <td class="num strong">@Fmt.Money(o.Total, o.CurrencyCode)</td>
                                <td>
                                    <StatusPill Text="@text" Tone="@tone" />
                                    @if (o.InvoiceNumber is not null)
                                    {
                                        <div class="muted" style="font-size:12px;margin-top:4px">@o.InvoiceNumber</div>
                                    }
                                </td>
                                <td class="actions-col" @onclick:stopPropagation>
                                    <KebabMenu>
                                        <button @onclick="() => OpenAsync(o)"><Icon Name="clipboard" Size="18" />@T("orders.ver_detalle")</button>
                                        @if (o.PendingApproval && o.Status != OrderStatuses.Cancelled && Session.Can(ErpPermissions.ApproveCredit))
                                        {
                                            <button @onclick="() => ApproveAsync(o)"><Icon Name="check" Size="18" />@T("orders.aprobar")</button>
                                        }
                                        @if (o.CanInvoice && Session.Can(ErpPermissions.IssueInvoice))
                                        {
                                            <button @onclick="() => StartInvoiceAsync(o)"><Icon Name="receipt" Size="18" />@T("orders.emitir_comprobante")</button>
                                        }
                                        @if (o.CanInvoiceShipments && Session.Can(ErpPermissions.IssueInvoice))
                                        {
                                            <button @onclick="() => OpenAsync(o)"><Icon Name="truck" Size="18" />@T("orders.facturar_despachos")</button>
                                        }
                                        @if (o.CanCancel && Session.Can(ErpPermissions.CancelOrder))
                                        {
                                            <button class="danger" @onclick="() => CancelAsync(o)"><Icon Name="ban" Size="18" />@T("orders.cancelar")</button>
                                        }
                                    </KebabMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="@(T("orders.pedidos"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_new is { } n)
{
    <Modal Title="@(T("orders.nuevo_pedido"))" Subtitle="@(T("orders.se_publica_en_la_suite"))" Size="lg" Error="@_error" OnClose="() => _new = null">
        <ChildContent>
            <div class="form-row">
                <div class="field">
                    <label>@T("orders.cliente")</label>
                    <select class="select" value="@n.CustomerId" @onchange="e => ChangeCustomerAsync(n, e.Value?.ToString())">
                        <option value="">@T("orders.elige_un_cliente")</option>
                        @foreach (var c in _customers)
                        {
                            <option value="@c.Id">@c.Label@(c.Detail is null ? "" : $" · {c.Detail}")</option>
                        }
                    </select>
                </div>
                @if (_rates.Count > 0)
                {
                    <div class="field">
                        <label>@T("orders.moneda")</label>
                        <select class="select" value="@n.Currency" @onchange="e => ChangeCurrency(n, e.Value?.ToString())">
                            <option value="@_currency">@_currency</option>
                            @foreach (var cur in _rates.Keys)
                            {
                                <option value="@cur">@cur · @T("orders.tipo_de_cambio", Fmt.Rate(_rates[cur]), _currency)</option>
                            }
                        </select>
                    </div>
                }
                <div class="field">
                    <label>@T("orders.despachar_desde")</label>
                    <select class="select" @bind="n.SiteId">
                        <option value="">@T("orders.sede_por_defecto")</option>
                        @foreach (var s in _sites)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
            </div>
            @if (n.Credit is { } cr)
            {
                var total = n.Lines.Sum(l => Tax.Round(l.Quantity * (l.Price ?? 0)));
                var inCompany = n.Currency == _currency ? total : _rates.TryGetValue(n.Currency, out var rate) ? total * rate : total;
                <div class="credit-line">
                    <span>@(cr.Terms.PaymentTermDays is { } days ? T("orders.plazo_n_dias", days) : T("orders.plazo_habitual"))</span>
                    @if (cr.Terms.DiscountPercent > 0)
                    {
                        <span>@T("orders.descuento_n", cr.Terms.DiscountPercent.ToString("0.##"))</span>
                    }
                    @if (cr.Available is { } available)
                    {
                        <span>@T("orders.disponible", Fmt.Money(available, cr.CompanyCurrency))</span>
                    }
                    @if (cr.Overdue > 0)
                    {
                        <span class="bad-text">@T("orders.vencido", Fmt.Money(cr.Overdue, cr.CompanyCurrency))</span>
                    }
                </div>
                @if (cr.Available is { } left && inCompany > left)
                {
                    <div class="alert warn"><Icon Name="alert" Size="18" /><span>@T("orders.supera_el_limite")</span></div>
                }
            }
            <LineEditor Lines="n.Lines" ShowPrice PriceLabel="@(T("orders.precio"))" DefaultPrice="i => PriceFor(n, i)" Changed="StateHasChanged" />
            <dl class="totals">
                <dt class="grand">@T("orders.total")</dt><dd class="grand">@Fmt.Money(n.Lines.Sum(l => Tax.Round(l.Quantity * (l.Price ?? 0))), n.Currency)</dd>
            </dl>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _new = null">@T("orders.cancelar")</button>
            <button class="btn btn-dark" disabled="@(_busy || n.Lines.Count == 0 || n.CustomerId is null)" @onclick="CreateAsync">@T("orders.crear_pedido")</button>
        </Footer>
    </Modal>
}

@if (_detail is { } d)
{
    var (text, tone) = StatusPill.ForOrder(d);
    <Modal Title="@(T("orders.pedido", d.Number))" Subtitle="@($"{d.CustomerName} · {Fmt.DateTime(d.CreatedAt)}")" Size="lg" OnClose="() => _detail = null">
        <ChildContent>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <StatusPill Text="@text" Tone="@tone" />
                <span class="muted">@Fmt.Source(d.Source) · @(d.SiteName ?? T("orders.sin_sede"))@(d.UserName is null ? "" : $" · {d.UserName}")</span>
            </div>
            @if (d.PendingApproval && d.Status != OrderStatuses.Cancelled)
            {
                <div class="alert warn"><Icon Name="alert" Size="18" /><span>@T("orders.por_aprobar_explica")</span></div>
            }
            else if (d.ApprovedBy is { } approver)
            {
                <div class="muted">@T("orders.aprobado_por", approver)</div>
            }
            @if (d.DispatchedAt is { } at)
            {
                <div class="alert info"><Icon Name="truck" Size="18" /><span>@T("orders.despachado_por_el_wms_el", Fmt.DateTime(at), (d.ShipmentNumber is null ? "" : $" ({d.ShipmentNumber})"), (d.Carrier is null ? "" : T("orders.con", d.Carrier)), (d.TrackingNumber is null ? "" : T("orders.guia", d.TrackingNumber)))</span></div>
            }
            <div class="table-wrap">
                <table class="data" style="min-width:480px">
                    <thead><tr><th>@T("orders.articulo")</th><th class="num">@T("orders.cant")</th><th class="num">@T("orders.precio")</th><th class="num">@T("orders.importe")</th></tr></thead>
                    <tbody>
                        @foreach (var l in _lines)
                        {
                            <tr>
                                <td><div class="two-line"><span class="t1">@l.ItemName</span><span class="t2">#@l.Sku</span></div></td>
                                <td class="num">@Fmt.Qty(l.Quantity)</td>
                                <td class="num">@Fmt.Money(l.UnitPrice, d.CurrencyCode)</td>
                                <td class="num strong">@Fmt.Money(l.Total, d.CurrencyCode)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <dl class="totals"><dt class="grand">@T("orders.total")</dt><dd class="grand">@Fmt.Money(d.Total, d.CurrencyCode)</dd></dl>
            @if (_shipments.Count > 0)
            {
                <h4 class="section-title">@T("orders.despachos")</h4>
                @foreach (var s in _shipments)
                {
                    <div class="list-row shipment-row" @key="s.Id">
                        <div class="two-line" style="flex:1;min-width:0">
                            <span class="t1">@(s.Number ?? "—") · @Fmt.DateTime(s.DispatchedAt)@(s.Partial ? T("orders.parcial_sufijo") : "")</span>
                            <span class="t2">@string.Join(", ", s.Lines.Select(l => $"{Fmt.Qty(l.Quantity)} × {l.ItemName}"))</span>
                        </div>
                        <strong class="end">@Fmt.Money(s.Total, d.CurrencyCode)</strong>
                        @if (s.InvoiceNumber is { } inv)
                        {
                            <span class="tag">@inv</span>
                        }
                        else if (d.InvoiceId is null && d.CustomerId is not null && Session.Can(ErpPermissions.IssueInvoice))
                        {
                            <button class="btn btn-sm" @onclick="() => StartShipmentInvoiceAsync(d, s)">@T("orders.facturar")</button>
                        }
                    </div>
                }
            }
        </ChildContent>
        <Footer>
            @if (d.CanCancel && Session.Can(ErpPermissions.CancelOrder))
            {
                <button class="btn btn-danger" @onclick="() => CancelAsync(d)"><Icon Name="ban" Size="18" />@T("orders.cancelar_pedido")</button>
            }
            @if (d.PendingApproval && d.Status != OrderStatuses.Cancelled && Session.Can(ErpPermissions.ApproveCredit))
            {
                <button class="btn btn-dark" @onclick="() => ApproveAsync(d)"><Icon Name="check" Size="18" />@T("orders.aprobar")</button>
            }
            else if (d.CanInvoice && Session.Can(ErpPermissions.IssueInvoice))
            {
                <button class="btn btn-dark" @onclick="() => StartInvoiceAsync(d)"><Icon Name="receipt" Size="18" />@T("orders.emitir_comprobante")</button>
            }
            else
            {
                <button class="btn btn-dark" @onclick="() => _detail = null">@T("orders.cerrar")</button>
            }
        </Footer>
    </Modal>
}

@if (_invoicing is { } inv)
{
    <Modal Title="@(_invoicingShipment is { } sh ? T("orders.comprobante_del_despacho", sh.Number ?? inv.Number) : T("orders.comprobante_del_pedido", inv.Number))" Subtitle="@inv.CustomerName" Size="sm" Error="@_error" OnClose="() => _invoicing = null">
        <ChildContent>
            <div class="segmented">
                <button class="@(_kind == InvoiceKinds.Invoice ? "on" : "")" @onclick="() => _kind = InvoiceKinds.Invoice">@T("orders.factura")</button>
                <button class="@(_kind == InvoiceKinds.Receipt ? "on" : "")" @onclick="() => _kind = InvoiceKinds.Receipt">@T("orders.boleta")</button>
            </div>
            <div class="field">
                <label>@T("orders.plazo_de_pago_dias")</label>
                <input class="control" type="number" min="0" step="1" @bind="_creditDays" />
            </div>
            <dl class="totals"><dt class="grand">@T("orders.total")</dt><dd class="grand">@Fmt.Money(_invoicingShipment?.Total ?? inv.Total, inv.CurrencyCode)</dd></dl>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _invoicing = null">@T("orders.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="InvoiceAsync">@T("orders.emitir", Fmt.InvoiceKind(_kind).ToLowerInvariant())</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class NewOrder
    {
        public Guid? CustomerId { get; set; }
        public Guid? SiteId { get; set; }
        public string Currency { get; set; } = "PEN";
        public CustomerCredit? Credit { get; set; }
        public List<LineEditor.LineDraft> Lines { get; } = [];
    }

    private static readonly (string Value, string Label)[] Tabs =
        [("", T("orders.todos")), ("uninvoiced", T("orders.por_facturar")), ("pending_approval", T("orders.por_aprobar")), (OrderStatuses.Open, T("orders.abiertos")), (OrderStatuses.Dispatched, T("orders.despachados")), (OrderStatuses.Cancelled, T("orders.cancelados"))];

    private PagedResult<OrderRow>? _result;
    private IReadOnlyList<QuoteRow> _quotes = [];
    private IReadOnlyList<Option> _customers = [];
    private IReadOnlyList<SiteRow> _sites = [];
    private string _search = "", _status = "", _currency = "PEN";
    private int _page = 1;
    private CancellationTokenSource? _debounce;

    private NewOrder? _new;
    private OrderRow? _detail, _invoicing;
    private ShipmentRow? _invoicingShipment;
    private IReadOnlyList<ShipmentRow> _shipments = [];
    private IReadOnlyList<OrderLineRow> _lines = [];
    private string _kind = InvoiceKinds.Invoice;
    private int _creditDays = InvoiceService.DefaultCreditDays;
    private string? _error;
    private bool _busy;

    protected override async Task LoadAsync()
    {
        _quotes = await Erp.Orders.GetQuotesAsync(pendingOnly: true);
        _result = await Erp.Orders.GetOrdersAsync(_search, _status == "" ? null : _status, _page, 15);
        _currency = (await Erp.Master.GetCompanyAsync())?.CurrencyCode ?? "PEN";
        if (_detail is { } open)
            _detail = await Erp.Orders.GetAsync(open.Id);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OpenNew()
    {
        _error = null;
        _customers = await Erp.Master.GetPartyOptionsAsync(suppliers: false);
        _sites = await Erp.Master.GetSitesAsync(activeOnly: true);
        _rates = await ForeignRatesAsync();
        _new = new NewOrder { SiteId = Session.DefaultSiteId, Currency = _currency };
    }

    /// <summary>Monedas con tipo de cambio del hub hacia la de la empresa: cuánto vale 1 unidad en la moneda de la empresa.</summary>
    private Dictionary<string, decimal> _rates = [];

    private async Task<Dictionary<string, decimal>> ForeignRatesAsync()
    {
        var rates = new Dictionary<string, decimal>();
        foreach (var r in await Erp.Master.GetLatestExchangeRatesAsync())
        {
            var other = r.To == _currency ? r.From : r.From == _currency ? r.To : null;
            if (other is not null && !rates.ContainsKey(other) && await Erp.Master.GetRateAsync(other, _currency) is { } rate)
                rates[other] = rate;
        }
        return rates;
    }

    /// <summary>Precio de lista del artículo en la moneda del pedido (convertido por la moneda de la empresa).</summary>
    private decimal? PriceIn(ItemRow item, string currency)
    {
        decimal? ToCompany(string cur) => cur == _currency ? 1m : _rates.TryGetValue(cur, out var r) ? r : null;
        if (item.CurrencyCode == currency)
            return item.Price;
        return ToCompany(item.CurrencyCode) is { } from && ToCompany(currency) is { } to
            ? VortexApi.Suite.Money.Currencies.Get(currency).Round(item.Price * from / to) : null;
    }

    /// <summary>Precio de lista en la moneda del pedido, con el descuento habitual del cliente.</summary>
    private decimal? PriceFor(NewOrder n, ItemRow item)
    {
        var list = PriceIn(item, n.Currency);
        var discount = n.Credit?.Terms.DiscountPercent ?? 0;
        return list is { } price && discount > 0 ? VortexApi.Suite.Money.Currencies.Get(n.Currency).Round(price * (1 - discount / 100m)) : list;
    }

    /// <summary>Cambia la moneda del pedido y recalcula los precios de lista de las líneas.</summary>
    private void ChangeCurrency(NewOrder n, string? currency)
    {
        n.Currency = currency ?? n.Currency;
        foreach (var l in n.Lines)
            l.Price = PriceFor(n, l.Item);
    }

    /// <summary>Al elegir el cliente se muestran su crédito y su plazo, y los precios toman su descuento.</summary>
    private async Task ChangeCustomerAsync(NewOrder n, string? value)
    {
        n.CustomerId = Guid.TryParse(value, out var id) ? id : null;
        n.Credit = n.CustomerId is { } customer ? await Erp.Master.GetCreditAsync(customer) : null;
        foreach (var l in n.Lines)
            l.Price = PriceFor(n, l.Item);
    }

    private async Task CreateAsync()
    {
        if (_new is not { CustomerId: { } customer } n)
            return;
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = await Erp.Orders.CreateAsync(customer, n.SiteId, n.Lines.Select(l => l.ToDocumentLine()).ToList(), n.Currency));
        _busy = false;
        if (_error is null)
        {
            if ((await Erp.Orders.GetOrdersAsync(number, null, 1, 1)).Items.FirstOrDefault() is { PendingApproval: true })
                Toasts.Info(T("orders.pedido_por_aprobar", number));
            else
                Toasts.Success(T("orders.pedido_creado", number));
            _new = null;
        }
    }

    private async Task ConvertAsync(QuoteRow quote)
    {
        _busy = true;
        string? number = null;
        await RunAsync(async () => number = await Erp.Orders.ConvertQuoteAsync(quote.Id, Session.DefaultSiteId));
        _busy = false;
        if (number is not null)
            Toasts.Success(T("orders.pedido_creado_desde_la_cotizacion", number));
    }

    private async Task OpenAsync(OrderRow order)
    {
        _lines = await Erp.Orders.GetLinesAsync(order.Id);
        _shipments = await Erp.Orders.GetShipmentsAsync(order.Id);
        _detail = order;
    }

    private async Task ApproveAsync(OrderRow order)
    {
        await RunAsync(() => Erp.Orders.ApproveAsync(order.Id), T("orders.pedido_aprobado", order.Number));
        _detail = null;
    }

    private async Task StartShipmentInvoiceAsync(OrderRow order, ShipmentRow shipment)
    {
        await StartInvoiceAsync(order);
        _invoicingShipment = shipment;
    }

    private async Task StartInvoiceAsync(OrderRow order)
    {
        _invoicingShipment = null;
        _error = null;
        _kind = InvoiceKinds.Invoice;
        _creditDays = await Erp.Invoices.GetTermDaysAsync(order.CustomerId);
        _detail = null;
        _invoicing = order;
    }

    private async Task InvoiceAsync()
    {
        if (_invoicing is not { } order)
            return;
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = _invoicingShipment is { } shipment
            ? await Erp.Invoices.IssueFromShipmentAsync(shipment.Id, _kind, _creditDays)
            : await Erp.Invoices.IssueFromOrderAsync(order.Id, _kind, _creditDays));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success(T("orders.emitida", Fmt.InvoiceKind(_kind), number));
            _invoicing = null;
        }
    }

    private async Task CancelAsync(OrderRow order)
    {
        await RunAsync(() => Erp.Orders.CancelAsync(order.Id), T("orders.pedido_cancelado", order.Number));
        _detail = null;
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}

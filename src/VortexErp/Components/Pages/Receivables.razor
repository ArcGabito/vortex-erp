@page "/cobranzas"
@inherits ErpPage
@inject FileExporter Exporter

<SectionContent SectionName="page-title">@T("receivables.cobranzas")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("receivables.cuentas_por_cobrar")</h2>
            <p>@T("receivables.saldo_pendiente_por_cliente_con")</p>
        </div>
        <a class="btn btn-dark" href="comprobantes"><Icon Name="receipt" Size="18" />@T("receivables.ir_comprobantes")</a>
    </div>

    @if (_aging.Count > 0)
    {
        <div class="stat-strip boxed">
            <StatTile Icon="wallet" Label="@(T("receivables.por_cobrar"))" Value="@Fmt.MoneyCompact(Main.Sum(r => r.Total), _currency)" Hint="@Fmt.Count(Main.Count(), T("count.cliente"), T("count.clientes"))" />
            <StatTile Icon="alert" Label="@(T("receivables.vencido"))" Value="@Fmt.MoneyCompact(Main.Sum(r => r.Overdue), _currency)" Hint="@Fmt.Count(Main.Count(r => r.Overdue > 0), T("count.cliente"), T("count.clientes"))" />
            <StatTile Icon="clock" Label="@(T("receivables.mas_de_90_dias"))" Value="@Fmt.MoneyCompact(Main.Sum(r => r.Over90), _currency)" UpIsGood="false" />
        </div>
    }

    <div class="card">
        <div class="card-head">
            <div>
                <h3>@T("receivables.antiguedad_de_saldos")</h3>
                <div class="sub">@T("receivables.antiguedad_explica")</div>
            </div>
        </div>
        <div class="card-body" style="padding-top:0">
            @if (_aging.Count == 0 && !Loading)
            {
                <EmptyState Icon="package-check" Title="@(T("receivables.todo_cobrado"))" Text="@(T("receivables.no_hay_comprobantes_con_saldo"))" />
            }
            else
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr>
                                <th>@T("receivables.cliente")</th><th class="num">@T("receivables.por_vencer")</th><th class="num">1-30</th>
                                <th class="num">31-60</th><th class="num">61-90</th><th class="num">+90</th><th class="num">@T("receivables.saldo")</th><th class="actions-col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _aging)
                            {
                                <tr @key="(r.CustomerId, r.CurrencyCode)">
                                    <td><div class="two-line"><span class="t1">@r.CustomerName</span><span class="t2">@r.CurrencyCode</span></div></td>
                                    <td class="num">@Cell(r.Current, r.CurrencyCode)</td>
                                    <td class="num">@Cell(r.Days1To30, r.CurrencyCode)</td>
                                    <td class="num">@Cell(r.Days31To60, r.CurrencyCode)</td>
                                    <td class="num">@Cell(r.Days61To90, r.CurrencyCode)</td>
                                    <td class="num"><span class="@(r.Over90 > 0 ? "qty-neg" : "faint")">@Cell(r.Over90, r.CurrencyCode)</span></td>
                                    <td class="num strong">@Fmt.Money(r.Total, r.CurrencyCode)</td>
                                    <td class="actions-col" style="width:auto;white-space:nowrap">
                                        @if (r.CustomerId is { } customer)
                                        {
                                            <button class="btn btn-sm" @onclick="() => OpenStatementAsync(customer, r.CurrencyCode)">@T("receivables.estado_de_cuenta")</button>
                                        }
                                        <a class="btn btn-sm btn-ghost" href="@($"comprobantes?q={Uri.EscapeDataString(r.CustomerName)}")">@T("receivables.ver")</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-head">
            <div>
                <h3>@T("receivables.ultimos_cobros")</h3>
                <div class="sub">@T("receivables.de_todos_los_equipos_del")</div>
            </div>
        </div>
        <div class="card-body">
            @if (_payments.Count == 0)
            {
                <div class="list-row"><span class="muted">@T("receivables.aun_no_hay_cobros_registrados")</span></div>
            }
            @foreach (var p in _payments)
            {
                <div class="list-row" @key="p.Id">
                    <Avatar Text="@(p.CustomerName ?? "?")" Size="34" />
                    <div class="two-line">
                        <span class="t1">@(p.CustomerName ?? T("receivables.clientes_varios"))</span>
                        <span class="t2">@p.Number · @Fmt.PaymentMethod(p.Method)@(p.InvoiceNumber is null ? "" : $" · {p.InvoiceNumber}") · @Fmt.Ago(p.ReceivedAt)</span>
                    </div>
                    <strong class="end qty-pos">@Fmt.Money(p.Amount, p.CurrencyCode)</strong>
                </div>
            }
        </div>
    </div>
</div>

@if (_statement is { } st)
{
    <Modal Title="@(T("receivables.estado_de_cuenta"))" Subtitle="@($"{st.CustomerName} · {st.CurrencyCode}")" Size="lg" Error="@_error" OnClose="() => _statement = null">
        <ChildContent>
            <div class="form-row three">
                <div class="field">
                    <label>@T("receivables.desde")</label>
                    <input class="control" type="date" value="@_from.ToString("yyyy-MM-dd")" @onchange="e => SetRangeAsync(e.Value, null)" />
                </div>
                <div class="field">
                    <label>@T("receivables.hasta")</label>
                    <input class="control" type="date" value="@_to.ToString("yyyy-MM-dd")" @onchange="e => SetRangeAsync(null, e.Value)" />
                </div>
                @if (_currencies.Count > 1)
                {
                    <div class="field">
                        <label>@T("receivables.moneda")</label>
                        <select class="select" value="@st.CurrencyCode" @onchange="e => ReloadStatementAsync(e.Value?.ToString())">
                            @foreach (var c in _currencies)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </div>
                }
            </div>
            <div class="table-wrap">
                <table class="data" style="min-width:640px">
                    <thead>
                        <tr><th>@T("receivables.fecha")</th><th>@T("receivables.documento")</th><th>@T("receivables.vence")</th><th class="num">@T("receivables.cargo")</th><th class="num">@T("receivables.abono")</th><th class="num">@T("receivables.saldo")</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Fmt.Date(_from)</td><td class="strong">@T("receivables.saldo_anterior")</td><td></td><td></td><td></td>
                            <td class="num strong">@Fmt.Money(st.OpeningBalance, st.CurrencyCode)</td>
                        </tr>
                        @foreach (var e in st.Entries)
                        {
                            <tr @key="e.DocumentId">
                                <td>@Fmt.Date(e.At)</td>
                                <td><div class="two-line"><span class="t1">@VortexErp.Core.Pdf.StatementPdf.KindName(e.Kind) @e.Number</span><span class="t2">@e.Reference</span></div></td>
                                <td><span class="muted">@(e.DueDate is { } due ? Fmt.Date(due) : "")</span></td>
                                <td class="num">@(e.Charge > 0 ? Fmt.Money(e.Charge, st.CurrencyCode) : "")</td>
                                <td class="num qty-pos">@(e.Credit > 0 ? Fmt.Money(e.Credit, st.CurrencyCode) : "")</td>
                                <td class="num strong">@Fmt.Money(e.Balance, st.CurrencyCode)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <dl class="totals">
                <dt class="grand">@(st.ClosingBalance < 0 ? T("receivables.saldo_a_favor") : T("receivables.saldo_al", Fmt.Date(_to)))</dt>
                <dd class="grand">@Fmt.Money(Math.Abs(st.ClosingBalance), st.CurrencyCode)</dd>
                @if (st.Overdue > 0)
                {
                    <dt>@T("receivables.vencido_a_hoy")</dt><dd class="warn-text">@Fmt.Money(st.Overdue, st.CurrencyCode)</dd>
                }
            </dl>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _statement = null">@T("receivables.cerrar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="ExportPdfAsync"><Icon Name="download" Size="18" />@T("receivables.descargar_pdf")</button>
        </Footer>
    </Modal>
}

@code {
    private IReadOnlyList<AgingRow> _aging = [];
    private IReadOnlyList<PaymentRow> _payments = [];
    private string _currency = "PEN";

    private CustomerStatement? _statement;
    private IReadOnlyList<string> _currencies = [];
    private DateOnly _from, _to;
    private string? _error;
    private bool _busy;

    /// <summary>Los saldos en la moneda de la empresa, para los indicadores (los de otras monedas se ven en la tabla).</summary>
    private IEnumerable<AgingRow> Main => _aging.Where(r => r.CurrencyCode == _currency);

    private string Cell(decimal value, string currency) => value == 0 ? "—" : Fmt.Money(value, currency);

    protected override async Task LoadAsync()
    {
        _aging = await Erp.Invoices.GetAgingAsync();
        _payments = (await Erp.Invoices.GetPaymentsAsync(null, 1, 12)).Items;
        _currency = (await Erp.Master.GetCompanyAsync())?.CurrencyCode ?? "PEN";
    }

    private async Task OpenStatementAsync(Guid customerId, string currency)
    {
        _error = null;
        _to = Fmt.Today;
        _from = new DateOnly(_to.Year, _to.Month, 1).AddMonths(-2);
        _currencies = await Erp.Invoices.GetCustomerCurrenciesAsync(customerId);
        _statement = await Erp.Invoices.GetStatementAsync(customerId, currency, _from, _to);
    }

    private async Task SetRangeAsync(object? from, object? to)
    {
        if (DateOnly.TryParse(from?.ToString(), out var f))
            _from = f;
        if (DateOnly.TryParse(to?.ToString(), out var t))
            _to = t;
        await ReloadStatementAsync(_statement?.CurrencyCode);
    }

    private async Task ReloadStatementAsync(string? currency)
    {
        if (_statement is not { } current || currency is null)
            return;
        CustomerStatement? next = null;
        _error = await TryAsync(async () => next = await Erp.Invoices.GetStatementAsync(current.CustomerId, currency, _from, _to));
        if (next is not null)
            _statement = next;
    }

    private async Task ExportPdfAsync()
    {
        if (_statement is not { } st)
            return;
        _busy = true;
        await RunAsync(async () =>
        {
            var pdf = VortexErp.Core.Pdf.StatementPdf.Generate(st, await Erp.Master.GetCompanyAsync(), Fmt.Culture);
            var name = $"estado-de-cuenta-{Slug(st.CustomerName)}-{st.To:yyyy-MM-dd}.pdf";
            await Exporter.ExportBytesAsync(name, pdf, "application/pdf");
        });
        _busy = false;
    }

    private static string Slug(string text) =>
        new string(text.ToLowerInvariant().Select(ch => char.IsLetterOrDigit(ch) ? ch : '-').ToArray()).Trim('-');
}

@* Marca: tres capas isométricas (la superior naranja) + "vortexerp". *@
<div class="logo @(OnDark ? "on-dark" : "")">
    <svg width="@Size" height="@Size" viewBox="0 0 48 48" aria-hidden="true">
        <path d="M7 32 L24 40 L41 32 L41 36.5 L24 44.5 L7 36.5 Z" fill="@(OnDark ? "#FFC2A3" : "#4A362C")" />
        <path d="M7 22.5 L24 30.5 L41 22.5 L41 27 L24 35 L7 27 Z" fill="@(OnDark ? "#FFFFFF" : "#1C120D")" />
        <path d="M24 5 L41 13 L24 21 L7 13 Z" fill="#FF5B14" />
        <path d="M7 13 L24 21 L41 13 L41 17.5 L24 25.5 L7 17.5 Z" fill="#FF7A3D" />
    </svg>
    @if (!IconOnly)
    {
        <span class="word">vortex<b>erp</b></span>
    }
</div>

@code {
    [Parameter] public int Size { get; set; } = 34;
    [Parameter] public bool OnDark { get; set; }
    [Parameter] public bool IconOnly { get; set; }
}

@page "/pedidos"
@inherits ErpPage

<SectionContent SectionName="page-title">Pedidos</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>Pedidos de venta</h2>
            <p>Los que creas aquí, los del CRM y los del WMS. El WMS los despacha y aquí se facturan.</p>
        </div>
        @if (Session.Can(ErpPermissions.CreateOrder))
        {
            <button class="btn btn-dark" @onclick="OpenNew"><Icon Name="plus" Size="18" />Nuevo pedido</button>
        }
    </div>

    @if (_quotes.Count > 0)
    {
        <div class="card">
            <div class="card-head">
                <div>
                    <h3>Cotizaciones aceptadas en el CRM</h3>
                    <div class="sub">Conviértelas en pedido para que el WMS las prepare.</div>
                </div>
            </div>
            <div class="card-body">
                @foreach (var q in _quotes)
                {
                    <div class="list-row" @key="q.Id">
                        <Avatar Text="@(q.CustomerName ?? "?")" Size="36" />
                        <div class="two-line" style="flex:1">
                            <span class="t1">@(q.Number ?? "Cotización") · @(q.CustomerName ?? "Cliente desconocido")</span>
                            <span class="t2">Aceptada @Fmt.Ago(q.AcceptedAt) · @Fmt.Count(q.LineCount, "línea", "líneas")</span>
                        </div>
                        <strong>@Fmt.Money(q.Total, q.CurrencyCode)</strong>
                        <button class="btn btn-sm btn-dark" disabled="@(_busy || q.CustomerId is null || !Session.Can(ErpPermissions.ConvertQuote))" @onclick="() => ConvertAsync(q)">Crear pedido</button>
                    </div>
                }
            </div>
        </div>
    }

    <div class="filters">
        <div class="field search">
            <label>Buscar</label>
            <div class="input-icon">
                <Icon Name="search" Size="16" />
                <input class="control" placeholder="Número, cliente o RUC" value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>
        <div class="field" style="width:auto">
            <label>Mostrar</label>
            <div class="segmented">
                @foreach (var (value, label) in Tabs)
                {
                    <button class="@(_status == value ? "on" : "")" @onclick="async () => { _status = value; _page = 1; await ReloadAsync(); }">@label</button>
                }
            </div>
        </div>
    </div>

    @if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="clipboard" Title="No hay pedidos" Text="Crea un pedido o espera los que lleguen del CRM." />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr><th>Pedido</th><th>Cliente</th><th>Origen</th><th class="num">Total</th><th>Estado</th><th class="actions-col">Acciones</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var o in page.Items)
                        {
                            var (text, tone) = StatusPill.ForOrder(o);
                            <tr @key="o.Id" style="cursor:pointer" @onclick="() => OpenAsync(o)">
                                <td><div class="two-line"><span class="t1">@o.Number</span><span class="t2">@Fmt.DateTime(o.CreatedAt) · @(o.SiteName ?? "Sin sede")</span></div></td>
                                <td><span style="font-weight:600">@(o.CustomerName ?? "—")</span></td>
                                <td><span class="muted">@Fmt.Source(o.Source)</span></td>
                                <td class="num strong">@Fmt.Money(o.Total, o.CurrencyCode)</td>
                                <td>
                                    <StatusPill Text="@text" Tone="@tone" />
                                    @if (o.InvoiceNumber is not null)
                                    {
                                        <div class="muted" style="font-size:12px;margin-top:4px">@o.InvoiceNumber</div>
                                    }
                                </td>
                                <td class="actions-col" @onclick:stopPropagation>
                                    <KebabMenu>
                                        <button @onclick="() => OpenAsync(o)"><Icon Name="clipboard" Size="18" />Ver detalle</button>
                                        @if (o.CanInvoice && Session.Can(ErpPermissions.IssueInvoice))
                                        {
                                            <button @onclick="() => StartInvoice(o)"><Icon Name="receipt" Size="18" />Emitir comprobante</button>
                                        }
                                        @if (o.CanCancel && Session.Can(ErpPermissions.CancelOrder))
                                        {
                                            <button class="danger" @onclick="() => CancelAsync(o)"><Icon Name="ban" Size="18" />Cancelar</button>
                                        }
                                    </KebabMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="pedidos" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_new is { } n)
{
    <Modal Title="Nuevo pedido" Subtitle="Se publica en la suite: el WMS reserva el stock y lo prepara." Size="lg" Error="@_error" OnClose="() => _new = null">
        <ChildContent>
            <div class="form-row">
                <div class="field">
                    <label>Cliente</label>
                    <select class="select" @bind="n.CustomerId">
                        <option value="">Elige un cliente</option>
                        @foreach (var c in _customers)
                        {
                            <option value="@c.Id">@c.Label@(c.Detail is null ? "" : $" · {c.Detail}")</option>
                        }
                    </select>
                </div>
                <div class="field">
                    <label>Despachar desde</label>
                    <select class="select" @bind="n.SiteId">
                        <option value="">Sede por defecto</option>
                        @foreach (var s in _sites)
                        {
                            <option value="@s.Id">@s.Name</option>
                        }
                    </select>
                </div>
            </div>
            <LineEditor Lines="n.Lines" ShowPrice PriceLabel="Precio" DefaultPrice="i => i.Price" Changed="StateHasChanged" />
            <dl class="totals">
                <dt class="grand">Total</dt><dd class="grand">@Fmt.Money(n.Lines.Sum(l => Tax.Round(l.Quantity * (l.Price ?? 0))), _currency)</dd>
            </dl>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _new = null">Cancelar</button>
            <button class="btn btn-dark" disabled="@(_busy || n.Lines.Count == 0 || n.CustomerId is null)" @onclick="CreateAsync">Crear pedido</button>
        </Footer>
    </Modal>
}

@if (_detail is { } d)
{
    var (text, tone) = StatusPill.ForOrder(d);
    <Modal Title="@($"Pedido {d.Number}")" Subtitle="@($"{d.CustomerName} · {Fmt.DateTime(d.CreatedAt)}")" Size="lg" OnClose="() => _detail = null">
        <ChildContent>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <StatusPill Text="@text" Tone="@tone" />
                <span class="muted">@Fmt.Source(d.Source) · @(d.SiteName ?? "Sin sede")@(d.UserName is null ? "" : $" · {d.UserName}")</span>
            </div>
            @if (d.DispatchedAt is { } at)
            {
                <div class="alert info"><Icon Name="truck" Size="18" /><span>Despachado por el WMS el @Fmt.DateTime(at)@(d.ShipmentNumber is null ? "" : $" ({d.ShipmentNumber})")@(d.Carrier is null ? "" : $" con {d.Carrier}")@(d.TrackingNumber is null ? "" : $", guía {d.TrackingNumber}").</span></div>
            }
            <div class="table-wrap">
                <table class="data" style="min-width:480px">
                    <thead><tr><th>Artículo</th><th class="num">Cant.</th><th class="num">Precio</th><th class="num">Importe</th></tr></thead>
                    <tbody>
                        @foreach (var l in _lines)
                        {
                            <tr>
                                <td><div class="two-line"><span class="t1">@l.ItemName</span><span class="t2">#@l.Sku</span></div></td>
                                <td class="num">@Fmt.Qty(l.Quantity)</td>
                                <td class="num">@Fmt.Money(l.UnitPrice, d.CurrencyCode)</td>
                                <td class="num strong">@Fmt.Money(l.Total, d.CurrencyCode)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <dl class="totals"><dt class="grand">Total</dt><dd class="grand">@Fmt.Money(d.Total, d.CurrencyCode)</dd></dl>
        </ChildContent>
        <Footer>
            @if (d.CanCancel && Session.Can(ErpPermissions.CancelOrder))
            {
                <button class="btn btn-danger" @onclick="() => CancelAsync(d)"><Icon Name="ban" Size="18" />Cancelar pedido</button>
            }
            @if (d.CanInvoice && Session.Can(ErpPermissions.IssueInvoice))
            {
                <button class="btn btn-dark" @onclick="() => StartInvoice(d)"><Icon Name="receipt" Size="18" />Emitir comprobante</button>
            }
            else
            {
                <button class="btn btn-dark" @onclick="() => _detail = null">Cerrar</button>
            }
        </Footer>
    </Modal>
}

@if (_invoicing is { } inv)
{
    <Modal Title="@($"Comprobante del pedido {inv.Number}")" Subtitle="@inv.CustomerName" Size="sm" Error="@_error" OnClose="() => _invoicing = null">
        <ChildContent>
            <div class="segmented">
                <button class="@(_kind == InvoiceKinds.Invoice ? "on" : "")" @onclick="() => _kind = InvoiceKinds.Invoice">Factura</button>
                <button class="@(_kind == InvoiceKinds.Receipt ? "on" : "")" @onclick="() => _kind = InvoiceKinds.Receipt">Boleta</button>
            </div>
            <div class="field">
                <label>Plazo de pago (días)</label>
                <input class="control" type="number" min="0" step="1" @bind="_creditDays" />
            </div>
            <dl class="totals"><dt class="grand">Total</dt><dd class="grand">@Fmt.Money(inv.Total, inv.CurrencyCode)</dd></dl>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _invoicing = null">Cancelar</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="InvoiceAsync">Emitir @Fmt.InvoiceKind(_kind).ToLowerInvariant()</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class NewOrder
    {
        public Guid? CustomerId { get; set; }
        public Guid? SiteId { get; set; }
        public List<LineEditor.LineDraft> Lines { get; } = [];
    }

    private static readonly (string Value, string Label)[] Tabs =
        [("", "Todos"), ("uninvoiced", "Por facturar"), (OrderStatuses.Open, "Abiertos"), (OrderStatuses.Dispatched, "Despachados"), (OrderStatuses.Cancelled, "Cancelados")];

    private PagedResult<OrderRow>? _result;
    private IReadOnlyList<QuoteRow> _quotes = [];
    private IReadOnlyList<Option> _customers = [];
    private IReadOnlyList<SiteRow> _sites = [];
    private string _search = "", _status = "", _currency = "PEN";
    private int _page = 1;
    private CancellationTokenSource? _debounce;

    private NewOrder? _new;
    private OrderRow? _detail, _invoicing;
    private IReadOnlyList<OrderLineRow> _lines = [];
    private string _kind = InvoiceKinds.Invoice;
    private int _creditDays = InvoiceService.DefaultCreditDays;
    private string? _error;
    private bool _busy;

    protected override async Task LoadAsync()
    {
        _quotes = await Erp.Orders.GetQuotesAsync(pendingOnly: true);
        _result = await Erp.Orders.GetOrdersAsync(_search, _status == "" ? null : _status, _page, 15);
        _currency = (await Erp.Master.GetCompanyAsync())?.CurrencyCode ?? "PEN";
        if (_detail is { } open)
            _detail = await Erp.Orders.GetAsync(open.Id);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OpenNew()
    {
        _error = null;
        _customers = await Erp.Master.GetPartyOptionsAsync(suppliers: false);
        _sites = await Erp.Master.GetSitesAsync(activeOnly: true);
        _new = new NewOrder { SiteId = Session.DefaultSiteId };
    }

    private async Task CreateAsync()
    {
        if (_new is not { CustomerId: { } customer } n)
            return;
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = await Erp.Orders.CreateAsync(customer, n.SiteId, n.Lines.Select(l => l.ToDocumentLine()).ToList(), _currency));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success($"Pedido {number} creado.");
            _new = null;
        }
    }

    private async Task ConvertAsync(QuoteRow quote)
    {
        _busy = true;
        string? number = null;
        await RunAsync(async () => number = await Erp.Orders.ConvertQuoteAsync(quote.Id, Session.DefaultSiteId));
        _busy = false;
        if (number is not null)
            Toasts.Success($"Pedido {number} creado desde la cotización.");
    }

    private async Task OpenAsync(OrderRow order)
    {
        _lines = await Erp.Orders.GetLinesAsync(order.Id);
        _detail = order;
    }

    private void StartInvoice(OrderRow order)
    {
        _error = null;
        _kind = InvoiceKinds.Invoice;
        _creditDays = InvoiceService.DefaultCreditDays;
        _detail = null;
        _invoicing = order;
    }

    private async Task InvoiceAsync()
    {
        if (_invoicing is not { } order)
            return;
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = await Erp.Invoices.IssueFromOrderAsync(order.Id, _kind, _creditDays));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success($"{Fmt.InvoiceKind(_kind)} {number} emitida.");
            _invoicing = null;
        }
    }

    private async Task CancelAsync(OrderRow order)
    {
        await RunAsync(() => Erp.Orders.CancelAsync(order.Id), $"Pedido {order.Number} cancelado.");
        _detail = null;
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}

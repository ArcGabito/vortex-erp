@page "/comprobantes"
@inherits ErpPage

<SectionContent SectionName="page-title">@T("invoices.comprobantes_2")</SectionContent>

<div class="page">
    <div class="page-head">
        <div>
            <h2>@T("invoices.comprobantes_2")</h2>
            <p>@T("invoices.facturas_boletas_emitidas_desde_pedidos")</p>
        </div>
    </div>

    <div class="filters">
        <div class="field" style="width:auto">
            <label>@T("invoices.ver")</label>
            <div class="segmented">
                <button class="@(!_posTab ? "on" : "")" @onclick="async () => { _posTab = false; _page = 1; await ReloadAsync(); }">@T("invoices.emitidos")</button>
                <button class="@(_posTab ? "on" : "")" @onclick="async () => { _posTab = true; _page = 1; await ReloadAsync(); }">
                    @T("invoices.ventas_de_caja_sin_comprobante", (_posPending > 0 ? $" ({_posPending})" : ""))
                </button>
            </div>
        </div>
        @if (!_posTab)
        {
            <div class="field search">
                <label>@T("invoices.buscar")</label>
                <div class="input-icon">
                    <Icon Name="search" Size="16" />
                    <input class="control" placeholder="@(T("invoices.numero_cliente_ruc"))" value="@_search" @oninput="OnSearchInput" />
                </div>
            </div>
            <div class="field">
                <label>@T("invoices.tipo")</label>
                <select class="select" value="@_kind" @onchange="async e => { _kind = e.Value?.ToString() ?? string.Empty; _page = 1; await ReloadAsync(); }">
                    <option value="">@T("invoices.todos")</option>
                    <option value="@InvoiceKinds.Invoice">@T("invoices.facturas")</option>
                    <option value="@InvoiceKinds.Receipt">@T("invoices.boletas")</option>
                </select>
            </div>
            <div class="field" style="width:auto">
                <label>@T("invoices.estado")</label>
                <div class="segmented">
                    <button class="@(_unpaid is null ? "on" : "")" @onclick="async () => { _unpaid = null; _page = 1; await ReloadAsync(); }">@T("invoices.todos")</button>
                    <button class="@(_unpaid == true ? "on" : "")" @onclick="async () => { _unpaid = true; _page = 1; await ReloadAsync(); }">@T("invoices.por_cobrar")</button>
                    <button class="@(_unpaid == false ? "on" : "")" @onclick="async () => { _unpaid = false; _page = 1; await ReloadAsync(); }">@T("invoices.pagados")</button>
                </div>
            </div>
        }
    </div>

    @if (_posTab && _sales is { } sales)
    {
        @if (sales.Total == 0 && !Loading)
        {
            <EmptyState Icon="receipt" Title="@(T("invoices.nada_pendiente"))" Text="@(T("invoices.las_ventas_del_pos_que"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>@T("invoices.venta_de_caja")</th><th>@T("invoices.cliente")</th><th>@T("invoices.tienda")</th><th class="num">@T("invoices.total")</th><th class="actions-col"></th></tr></thead>
                    <tbody>
                        @foreach (var s in sales.Items)
                        {
                            <tr @key="s.Id">
                                <td><div class="two-line"><span class="t1">@s.Number</span><span class="t2">@Fmt.DateTime(s.CreatedAt)</span></div></td>
                                <td>
                                    <div class="two-line">
                                        <span class="t1" style="font-weight:600">@(s.CustomerName ?? T("invoices.clientes_varios"))</span>
                                        @if (s.Credit > 0)
                                        {
                                            <span class="t2">@T("invoices.al_credito", (Fmt.Money(s.Credit, s.CurrencyCode)))</span>
                                        }
                                    </div>
                                </td>
                                <td><span class="muted">@s.SiteName</span></td>
                                <td class="num strong">@Fmt.Money(s.Total, s.CurrencyCode)</td>
                                <td class="actions-col" style="width:auto;white-space:nowrap">
                                    <button class="btn btn-sm" disabled="@(_busy || !Session.Can(ErpPermissions.IssueInvoice))" @onclick="() => IssueSaleAsync(s, InvoiceKinds.Receipt)">@T("invoices.boleta")</button>
                                    @if (s.CustomerId is not null && Session.Can(ErpPermissions.IssueInvoice))
                                    {
                                        <button class="btn btn-sm btn-dark" disabled="@_busy" @onclick="() => IssueSaleAsync(s, InvoiceKinds.Invoice)">@T("invoices.factura")</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="sales.Page" PageSize="sales.PageSize" Total="sales.Total" Noun="@(T("invoices.ventas"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
    else if (_result is { } page)
    {
        @if (page.Total == 0 && !Loading)
        {
            <EmptyState Icon="receipt" Title="@(T("invoices.no_hay_comprobantes"))" Text="@(T("invoices.emitelos_desde_un_pedido_desde"))" />
        }
        else
        {
            <div class="table-wrap">
                <table class="data">
                    <thead><tr><th>@T("invoices.comprobante")</th><th>@T("invoices.cliente")</th><th>@T("invoices.vence")</th><th class="num">@T("invoices.total")</th><th class="num">@T("invoices.saldo_2")</th><th>@T("invoices.estado")</th><th class="actions-col">@T("invoices.acciones")</th></tr></thead>
                    <tbody>
                        @foreach (var i in page.Items)
                        {
                            var (text, tone) = StatusPill.ForInvoice(i, Fmt.Today);
                            <tr @key="i.Id" style="cursor:pointer" @onclick="() => OpenAsync(i)">
                                <td><div class="two-line"><span class="t1">@i.Number</span><span class="t2">@Fmt.InvoiceKind(i.Kind) · @Fmt.Date(i.IssuedAt)</span></div></td>
                                <td><div class="two-line"><span class="t1" style="font-weight:600">@(i.CustomerName ?? T("invoices.clientes_varios"))</span><span class="t2">@i.CustomerDocument</span></div></td>
                                <td><span class="muted">@(i.DueDate is { } due ? Fmt.Date(due) : "—")</span></td>
                                <td class="num">@Fmt.Money(i.Total, i.CurrencyCode)</td>
                                <td class="num strong">@Fmt.Money(i.Balance, i.CurrencyCode)</td>
                                <td><StatusPill Text="@text" Tone="@tone" /></td>
                                <td class="actions-col" @onclick:stopPropagation>
                                    <KebabMenu>
                                        <button @onclick="() => OpenAsync(i)"><Icon Name="receipt" Size="18" />@T("invoices.ver_detalle")</button>
                                        @if (!i.IsPaid && Session.Can(ErpPermissions.RegisterPayment))
                                        {
                                            <button @onclick="() => StartPayment(i)"><Icon Name="wallet" Size="18" />@T("invoices.registrar_cobro")</button>
                                        }
                                    </KebabMenu>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <Pager Page="page.Page" PageSize="page.PageSize" Total="page.Total" Noun="@(T("invoices.comprobantes"))" OnPage="async p => { _page = p; await ReloadAsync(); }" />
        }
    }
</div>

@if (_detail is { } d)
{
    var (text, tone) = StatusPill.ForInvoice(d, Fmt.Today);
    <Modal Title="@($"{Fmt.InvoiceKind(d.Kind)} {d.Number}")" Subtitle="@($"{d.CustomerName ?? "Clientes varios"} · {Fmt.DateTime(d.IssuedAt)}")" Size="lg" OnClose="() => _detail = null">
        <ChildContent>
            <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
                <StatusPill Text="@text" Tone="@tone" />
                <span class="muted">@(d.SaleId is not null ? T("invoices.venta_de_caja") : d.OrderId is not null ? T("invoices.pedido") : "")@(d.DueDate is { } due ? T("invoices.vence_el", Fmt.Date(due)) : "")</span>
            </div>
            <div class="table-wrap">
                <table class="data" style="min-width:480px">
                    <thead><tr><th>@T("invoices.descripcion")</th><th class="num">@T("invoices.cant")</th><th class="num">@T("invoices.precio")</th><th class="num">@T("invoices.importe")</th></tr></thead>
                    <tbody>
                        @foreach (var l in _lines)
                        {
                            <tr>
                                <td>@l.Description</td>
                                <td class="num">@Fmt.Qty(l.Quantity)</td>
                                <td class="num">@Fmt.Money(l.UnitPrice, d.CurrencyCode)</td>
                                <td class="num strong">@Fmt.Money(l.Total, d.CurrencyCode)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="grid-2" style="grid-template-columns:1fr 1fr">
                <div>
                    <h4 style="font-size:14px;margin-bottom:8px">@T("invoices.cobros")</h4>
                    @if (_payments.Count == 0)
                    {
                        <span class="muted">@(d.Paid > 0 ? T("invoices.pagado_en_caja") : T("invoices.aun_sin_cobros"))</span>
                    }
                    @foreach (var p in _payments)
                    {
                        <div class="list-row">
                            <div class="two-line"><span class="t1">@p.Number</span><span class="t2">@Fmt.PaymentMethod(p.Method) · @Fmt.Date(p.ReceivedAt)@(p.Reference is null ? "" : $" · {p.Reference}")</span></div>
                            <strong class="end">@Fmt.Money(p.Amount, p.CurrencyCode)</strong>
                        </div>
                    }
                </div>
                <dl class="totals">
                    <dt>@T("invoices.subtotal")</dt><dd>@Fmt.Money(d.Subtotal, d.CurrencyCode)</dd>
                    <dt>@T("invoices.impuesto")</dt><dd>@Fmt.Money(d.Tax, d.CurrencyCode)</dd>
                    <dt class="grand">@T("invoices.total")</dt><dd class="grand">@Fmt.Money(d.Total, d.CurrencyCode)</dd>
                    @if (d.Debited > 0)
                    {
                        <dt>@T("invoices.notas_de_debito")</dt><dd>+@Fmt.Money(d.Debited, d.CurrencyCode)</dd>
                    }
                    @if (d.Credited > 0)
                    {
                        <dt>@T("invoices.notas_de_credito")</dt><dd>−@Fmt.Money(d.Credited, d.CurrencyCode)</dd>
                    }
                    <dt>@T("invoices.cobrado")</dt><dd>@Fmt.Money(d.Paid, d.CurrencyCode)</dd>
                    <dt>@(d.Balance < 0 ? T("invoices.saldo_a_favor") : T("invoices.saldo_2"))</dt>
                    <dd class="@(d.Balance > 0 ? "warn-text" : "good-text")">@Fmt.Money(Math.Abs(d.Balance), d.CurrencyCode)</dd>
                </dl>
            </div>
            @if (d.IsVoided)
            {
                <div class="alert warn"><Icon Name="ban" Size="18" /><span>@T("invoices.anulado_el", Fmt.DateTime(d.VoidedAt ?? d.IssuedAt), d.VoidReason ?? "")</span></div>
            }
            @if (_notes.Count > 0)
            {
                <div>
                    <h4 style="font-size:14px;margin-bottom:8px">@T("invoices.notas")</h4>
                    @foreach (var n in _notes)
                    {
                        <div class="list-row" @key="n.Id">
                            <div class="two-line">
                                <span class="t1">@(n.Kind == NoteKinds.Credit ? T("invoices.nota_de_credito") : T("invoices.nota_de_debito")) @n.Number</span>
                                <span class="t2">@Fmt.NoteReason(n.Reason) · @Fmt.Date(n.IssuedAt)@(n.Description is null ? "" : $" · {n.Description}")</span>
                            </div>
                            <strong class="end @(n.Kind == NoteKinds.Credit ? "qty-pos" : "qty-neg")">@(n.Kind == NoteKinds.Credit ? "−" : "+")@Fmt.Money(n.Total, n.CurrencyCode)</strong>
                        </div>
                    }
                </div>
            }
        </ChildContent>
        <Footer>
            @if (!d.IsVoided && Session.Can(ErpPermissions.VoidInvoice) && d.CanVoid)
            {
                <button class="btn btn-danger" @onclick="() => StartVoid(d)"><Icon Name="ban" Size="18" />@T("invoices.anular")</button>
            }
            @if (!d.IsVoided && Session.Can(ErpPermissions.IssueNote))
            {
                @if (d.Creditable > 0)
                {
                    <button class="btn" @onclick="() => StartNote(d, NoteKinds.Credit)"><Icon Name="undo" Size="18" />@T("invoices.nota_de_credito")</button>
                }
                <button class="btn" @onclick="() => StartNote(d, NoteKinds.Debit)"><Icon Name="plus" Size="18" />@T("invoices.nota_de_debito")</button>
            }
            @if (!d.IsPaid && !d.IsVoided && Session.Can(ErpPermissions.RegisterPayment))
            {
                <button class="btn btn-dark" @onclick="() => StartPayment(d)"><Icon Name="wallet" Size="18" />@T("invoices.registrar_cobro")</button>
            }
            else
            {
                <button class="btn btn-dark" @onclick="() => _detail = null">@T("invoices.cerrar")</button>
            }
        </Footer>
    </Modal>
}

@if (_paying is { } pay)
{
    <Modal Title="@(T("invoices.registrar_cobro"))" Subtitle="@(T("invoices.saldo", pay.Number, (Fmt.Money(pay.Balance, pay.CurrencyCode))))" Size="sm" Error="@_error" OnClose="() => _paying = null">
        <ChildContent>
            <div class="field">
                <label>@T("invoices.monto", Fmt.Symbol(pay.CurrencyCode))</label>
                <input class="control" type="number" min="0" step="0.01" @bind="_amount" />
            </div>
            <div class="field">
                <label>@T("invoices.medio_de_pago")</label>
                <select class="select" @bind="_method">
                    @foreach (var m in PaymentMethods.All)
                    {
                        <option value="@m">@Fmt.PaymentMethod(m)</option>
                    }
                </select>
            </div>
            <div class="field">
                <label>@T("invoices.referencia_opcional")</label>
                <input class="control" placeholder="@(T("invoices.de_operacion"))" @bind="_reference" />
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _paying = null">@T("invoices.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="PayAsync">@T("invoices.registrar_cobro")</button>
        </Footer>
    </Modal>
}

@if (_noting is { } inv)
{
    var credit = _noteKind == NoteKinds.Credit;
    <Modal Title="@(credit ? T("invoices.nota_de_credito") : T("invoices.nota_de_debito"))"
           Subtitle="@(T("invoices.de_saldo", inv.Number, Fmt.Money(credit ? inv.Creditable : inv.Balance, inv.CurrencyCode)))"
           Size="@(credit && _noteReason == NoteReasons.Return ? "lg" : "sm")" Error="@_error" OnClose="() => _noting = null">
        <ChildContent>
            <div class="field">
                <label>@T("invoices.motivo")</label>
                <select class="select" @bind="_noteReason">
                    @foreach (var reason in credit ? NoteReasons.CreditReasons : NoteReasons.DebitReasons)
                    {
                        <option value="@reason">@Fmt.NoteReason(reason)</option>
                    }
                </select>
            </div>
            @if (credit && _noteReason == NoteReasons.Void)
            {
                <div class="alert info"><Icon Name="alert" Size="18" /><span>@T("invoices.anulacion_rebaja_todo", Fmt.Money(inv.Creditable, inv.CurrencyCode))</span></div>
            }
            else if (credit && _noteReason == NoteReasons.Return)
            {
                <div class="lines">
                    @foreach (var line in _noteLines)
                    {
                        <div class="line with-price" @key="line.Line.LineNo">
                            <div class="two-line">
                                <span class="t1">@line.Line.Description</span>
                                <span class="t2">@T("invoices.se_pueden_devolver", Fmt.Qty(line.Line.Returnable), Fmt.Money(line.Line.UnitPrice, inv.CurrencyCode))</span>
                            </div>
                            <input class="control" type="number" min="0" max="@line.Line.Returnable" step="any" @bind="line.Quantity" @bind:event="oninput" aria-label="@(T("invoices.cant"))" />
                            <strong style="text-align:right">@Fmt.Money(line.Line.Quantity == 0 ? 0 : line.Line.Total * line.Quantity / line.Line.Quantity, inv.CurrencyCode)</strong>
                            <span></span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="field">
                    <label>@T("invoices.monto_con_impuesto", Fmt.Symbol(inv.CurrencyCode))</label>
                    <input class="control" type="number" min="0" step="0.01" @bind="_amount" />
                </div>
            }
            <div class="field">
                <label>@(credit && _noteReason is NoteReasons.Void or NoteReasons.Return ? T("invoices.detalle_opcional") : T("invoices.descripcion"))</label>
                <input class="control" placeholder="@(credit ? T("invoices.ej_descuento_por_pronto_pago") : T("invoices.ej_intereses_por_mora"))" @bind="_reference" />
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _noting = null">@T("invoices.cancelar")</button>
            <button class="btn btn-dark" disabled="@_busy" @onclick="IssueNoteAsync">@T("invoices.emitir_nota")</button>
        </Footer>
    </Modal>
}

@if (_voiding is { } v)
{
    <Modal Title="@(T("invoices.anular_comprobante", v.Number))" Subtitle="@(T("invoices.anular_explica"))" Size="sm" Error="@_error" OnClose="() => _voiding = null">
        <ChildContent>
            <div class="field">
                <label>@T("invoices.motivo")</label>
                <input class="control" placeholder="@(T("invoices.ej_ruc_equivocado"))" @bind="_reference" />
            </div>
        </ChildContent>
        <Footer>
            <button class="btn" @onclick="() => _voiding = null">@T("invoices.cancelar")</button>
            <button class="btn btn-danger" disabled="@_busy" @onclick="VoidAsync">@T("invoices.anular")</button>
        </Footer>
    </Modal>
}

@code {
    private sealed class ReturnLine(InvoiceLineRow line)
    {
        public InvoiceLineRow Line { get; } = line;
        public decimal Quantity { get; set; }
    }

    private IReadOnlyList<InvoiceNoteRow> _notes = [];
    private InvoiceRow? _noting, _voiding;
    private string _noteKind = NoteKinds.Credit;
    private string _noteReason = NoteReasons.Return;
    private List<ReturnLine> _noteLines = [];

    private void StartNote(InvoiceRow invoice, string kind)
    {
        _error = null;
        _amount = 0;
        _reference = null;
        _noteKind = kind;
        _noteReason = kind == NoteKinds.Credit ? NoteReasons.Return : NoteReasons.Interest;
        _noteLines = _lines.Where(l => l.Returnable > 0).Select(l => new ReturnLine(l)).ToList();
        _detail = null;
        _noting = invoice;
    }

    private async Task IssueNoteAsync()
    {
        if (_noting is not { } invoice)
            return;
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = _noteKind == NoteKinds.Debit
            ? await Erp.Invoices.IssueDebitNoteAsync(invoice.Id, _noteReason, _amount, _reference ?? "")
            : await Erp.Invoices.IssueCreditNoteAsync(invoice.Id, _noteReason, _noteReason switch
            {
                NoteReasons.Void => [],
                NoteReasons.Return => _noteLines.Where(l => l.Quantity > 0).Select(l => new NoteLineDraft(l.Line.LineNo, l.Quantity)).ToList(),
                _ => [new NoteLineDraft(Amount: _amount, Description: _reference)],
            }, _reference));
        _busy = false;
        if (_error is not null)
            return;
        Toasts.Success(T("invoices.nota_emitida", number));
        _noting = null;
    }

    private void StartVoid(InvoiceRow invoice)
    {
        _error = null;
        _reference = null;
        _detail = null;
        _voiding = invoice;
    }

    private async Task VoidAsync()
    {
        if (_voiding is not { } invoice)
            return;
        _busy = true;
        _error = await TryAsync(() => Erp.Invoices.VoidAsync(invoice.Id, _reference ?? ""), T("invoices.comprobante_anulado", invoice.Number));
        _busy = false;
        if (_error is null)
            _voiding = null;
    }

    [SupplyParameterFromQuery(Name = "q")] public string? Query { get; set; }
    [SupplyParameterFromQuery(Name = "caja")] public int? PosQuery { get; set; }

    private PagedResult<InvoiceRow>? _result;
    private PagedResult<PosSaleRow>? _sales;
    private int _posPending;
    private bool _posTab;
    private string _search = "", _kind = "";
    private bool? _unpaid;
    private int _page = 1;
    private CancellationTokenSource? _debounce;

    private InvoiceRow? _detail, _paying;
    private IReadOnlyList<InvoiceLineRow> _lines = [];
    private IReadOnlyList<PaymentRow> _payments = [];
    private decimal _amount;
    private string _method = PaymentMethods.Transfer;
    private string? _reference, _error;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        if (PosQuery == 1 && !_posTab)
        {
            _posTab = true;
            await ReloadAsync();
        }
        if (Query is not null && Query != _search)
        {
            _search = Query;
            _posTab = false;
            _page = 1;
            await ReloadAsync();
        }
    }

    protected override async Task LoadAsync()
    {
        _posPending = (await Erp.Invoices.GetPosSalesAsync(uninvoicedOnly: true, 1, 1)).Total;
        if (_posTab)
            _sales = await Erp.Invoices.GetPosSalesAsync(uninvoicedOnly: true, _page, 15);
        else
            _result = await Erp.Invoices.GetInvoicesAsync(new InvoiceQuery(_search, _kind == "" ? null : _kind, _unpaid, Page: _page));
        if (_detail is { } open)
            _detail = await Erp.Invoices.GetAsync(open.Id);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(220, _debounce.Token);
            _page = 1;
            await ReloadAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OpenAsync(InvoiceRow invoice)
    {
        _lines = await Erp.Invoices.GetLinesAsync(invoice.Id);
        _payments = (await Erp.Invoices.GetPaymentsAsync(invoice.Id, 1, 50)).Items;
        _notes = await Erp.Invoices.GetNotesAsync(invoice.Id);
        _detail = invoice;
    }

    private void StartPayment(InvoiceRow invoice)
    {
        _error = null;
        _amount = invoice.Balance;
        _method = PaymentMethods.Transfer;
        _reference = null;
        _detail = null;
        _paying = invoice;
    }

    private async Task PayAsync()
    {
        if (_paying is not { } invoice)
            return;
        _busy = true;
        string? number = null;
        _error = await TryAsync(async () => number = await Erp.Invoices.RegisterPaymentAsync(invoice.Id, _amount, _method, _reference));
        _busy = false;
        if (_error is null)
        {
            Toasts.Success(T("invoices.cobro_registrado", number));
            _paying = null;
        }
    }

    private async Task IssueSaleAsync(PosSaleRow sale, string kind)
    {
        _busy = true;
        string? number = null;
        await RunAsync(async () => number = await Erp.Invoices.IssueFromSaleAsync(sale.Id, kind));
        _busy = false;
        if (number is not null)
            Toasts.Success(T("invoices.emitida_para", Fmt.InvoiceKind(kind), number, sale.Number));
    }

    public override void Dispose()
    {
        _debounce?.Cancel();
        base.Dispose();
    }
}
